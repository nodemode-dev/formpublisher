#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"
source setup/lib.sh

usage() {
  cat <<'EOF'
./build_app            build the FormPublisher desktop app from this folder, start to finish
  --no-install         macOS: leave the built app where it is instead of copying it to Applications
  --install            Linux: install the built .deb with apt (asks for your password)
  --open               open the app when the build is done
  --clean              rebuild the Rust side and the frozen engine from nothing
Every step's output goes to build_app.log beside this file. On Windows run build_app.bat.
EOF
}

install_app=auto open_app=0 clean=0
for arg in "$@"; do
  case "$arg" in
    --no-install) install_app=no ;;
    --install) install_app=yes ;;
    --open) open_app=1 ;;
    --clean) clean=1 ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done

log="$FORMPUBLISHER_ROOT/build_app.log"
: > "$log"
exec > >(tee -a "$log") 2>&1
trap 'status=$?; [ $status -eq 0 ] || printf "\n[formpublisher] the build stopped (exit %s). The full log is %s\n" "$status" "$log"' EXIT

os="$(fp_os)"
step() { printf '\n[formpublisher] == %s\n' "$*"; }

step "checking the tools"
[ "$os" = macos ] || [ "$os" = linux ] || fp_die "build_app runs on macOS and Linux; on Windows run build_app.bat"
if [ "$os" = macos ]; then
  xcode-select -p >/dev/null 2>&1 || fp_die "the Xcode command line tools are missing: run xcode-select --install, then ./build_app again"
fi
py="$(fp_python)" || fp_die "Python 3.12 or newer is required (on macOS: brew install python)"
command -v node >/dev/null 2>&1 || fp_die "Node 22.12 or newer is required (on macOS: brew install node)"
node -e 'const [a,b]=process.versions.node.split(".").map(Number); process.exit(a>22||(a===22&&b>=12)?0:1)' \
  || fp_die "Node $(node -v) is too old; Vite needs 22.12 or newer"
fp_rust_env
if ! command -v rustup >/dev/null 2>&1 && ! command -v cargo >/dev/null 2>&1; then
  fp_say "installing Rust with rustup (https://rustup.rs) into ~/.cargo; your shell profile is not changed"
  curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable --no-modify-path
  fp_rust_env
fi
if command -v rustup >/dev/null 2>&1; then
  rustup toolchain list | grep -q '^stable' || rustup toolchain install stable --profile minimal
  fp_rust_env
fi
[ "$(dirname "$(command -v rustc)")" = "$(dirname "$(command -v cargo)")" ] \
  || fp_die "rustc ($(command -v rustc)) and cargo ($(command -v cargo)) come from different installs; remove one and run ./build_app again"
if [ "$os" = linux ] && ! pkg-config --exists webkit2gtk-4.1 2>/dev/null; then
  fp_die "Tauri needs system libraries; on Debian or Ubuntu: sudo apt install libwebkit2gtk-4.1-dev build-essential curl wget file libxdo-dev libssl-dev librsvg2-dev patchelf"
fi
version="$("$py" -c 'import json, sys; print(json.load(open(sys.argv[1]))["version"])' src-tauri/tauri.conf.json)"
fp_say "building FormPublisher $version from $(pwd)"
fp_say "python $("$py" -c 'import platform; print(platform.python_version())'), node $(node -v), $(rustc -V), $(cargo -V | awk '{print $1, $2}') from $(dirname "$(command -v rustc)")"

step "installing the engine and the window"
[ -x backend/venv/bin/python ] && [ -d frontend/node_modules ] || ./formpublisher_oc_install

if [ "$os" = macos ]; then cache_root="$HOME/Library/Caches/formpublisher"; else cache_root="${XDG_CACHE_HOME:-$HOME/.cache}/formpublisher"; fi
export CARGO_TARGET_DIR="${FORMPUBLISHER_CARGO_TARGET:-$cache_root/tauri-target}"
mkdir -p "$CARGO_TARGET_DIR"
fp_say "Rust build folder: $CARGO_TARGET_DIR"

if [ "$clean" = 1 ]; then
  step "cleaning earlier builds"
  ( cd src-tauri && cargo clean )
  rm -rf backend/build/pyinstaller backend/dist-engine src-tauri/binaries/formpublisher-engine-* frontend/dist
fi
fp_rust_fresh

step "building the window"
( cd frontend && npm run build )
step "freezing the engine into the app's sidecar"
setup/freeze_backend

tauri_args=(build)
case "$os" in
  macos)
    tauri_args+=(--bundles app)
    [ -n "${APPLE_SIGNING_IDENTITY:-}" ] || tauri_args+=(--config '{"bundle":{"macOS":{"signingIdentity":"-"}}}')
    ;;
  linux) tauri_args+=(--bundles "${FORMPUBLISHER_BUNDLES:-deb}") ;;
esac

step "building the desktop app (the first build compiles several hundred Rust crates)"
tlog="$(mktemp)"
if ! npx --yes @tauri-apps/cli@2 "${tauri_args[@]}" 2>&1 | tee "$tlog"; then
  grep -Eq 'error\[E|could not compile' "$tlog" || fp_die "tauri build failed outside the Rust compile; see the lines above"
  fp_say "the Rust compile failed; cleaning the build folder and trying once more, one crate at a time"
  ( cd src-tauri && cargo clean )
  fp_rust_fresh
  CARGO_BUILD_JOBS=1 npx --yes @tauri-apps/cli@2 "${tauri_args[@]}" || fp_die "tauri build failed twice; send build_app.log"
fi
rm -f "$tlog"

bundle="$CARGO_TARGET_DIR/release/bundle"

if [ "$os" = macos ]; then
  app="$bundle/macos/FormPublisher.app"
  [ -d "$app" ] || fp_die "the build finished but $app is missing"
  if [ -n "${APPLE_SIGNING_IDENTITY:-}" ]; then
    codesign --verify --deep --strict "$app" || fp_die "codesign could not verify the signed app; nothing was packed"
  else
    codesign --verify --deep --strict "$app" 2>/dev/null || fp_say "codesign could not verify the app; it is ad-hoc signed, so macOS may ask once before it opens"
  fi
  step "checking the engine inside the app"
  FORMPUBLISHER_HOME="$(mktemp -d)" "$app/Contents/MacOS/formpublisher-engine" --selfcheck >/dev/null \
    || fp_die "the engine inside the app failed its self-check under the app's signature; run $app/Contents/MacOS/formpublisher-engine --selfcheck to see why. Nothing was packed"
  step "packing the disk image"
  mkdir -p "$bundle/dmg"
  dmg="$bundle/dmg/FormPublisher_${version}_$(uname -m).dmg"
  stage="$(mktemp -d)"
  ditto "$app" "$stage/FormPublisher.app"
  ln -s /Applications "$stage/Applications"
  rm -f "$dmg"
  hdiutil create -quiet -volname FormPublisher -srcfolder "$stage" -ov -format UDZO "$dmg"
  rm -rf "$stage"
  fp_say "app: $app"
  fp_say "disk image: $dmg"
  target_app=""
  if [ "$install_app" != no ]; then
    dest=/Applications
    [ -w "$dest" ] || { dest="$HOME/Applications"; mkdir -p "$dest"; }
    if pgrep -x formpublisher >/dev/null 2>&1; then
      osascript -e 'tell application "FormPublisher" to quit' >/dev/null 2>&1 || true
      sleep 2
    fi
    rm -rf "$dest/FormPublisher.app"
    ditto "$app" "$dest/FormPublisher.app"
    xattr -dr com.apple.quarantine "$dest/FormPublisher.app" 2>/dev/null || true
    target_app="$dest/FormPublisher.app"
    fp_say "installed: $target_app"
  fi
  if [ "$open_app" = 1 ]; then open "${target_app:-$app}"; fi
else
  deb="$(ls -t "$bundle"/deb/*.deb 2>/dev/null | head -1 || true)"
  [ -n "$deb" ] && fp_say "package: $deb"
  ls "$bundle"/*/ 2>/dev/null | sed 's/^/  /'
  if [ "$install_app" = yes ] && [ -n "$deb" ]; then
    sudo apt install -y "$deb"
  elif [ -n "$deb" ]; then
    fp_say "install it with: sudo apt install $deb   (or run ./build_app --install)"
  fi
  if [ "$open_app" = 1 ]; then
    "$CARGO_TARGET_DIR/release/formpublisher" >/dev/null 2>&1 &
  fi
fi
fp_say "done in ${SECONDS}s"
